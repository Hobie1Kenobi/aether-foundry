#!/bin/sh
# Stop only the pid files this release wrote.
set -eu
HOME_DIR=${FOUNDRY_MISSION_HOME:-/workspace/foundry-ops/missions-runtime}
for name in worker signer; do
  pidfile="$HOME_DIR/$name.pid"
  if [ -f "$pidfile" ]; then
    pid=$(cat "$pidfile")
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid"
    fi
    rm -f "$pidfile"
  fi
done
echo "stopped"
