#!/bin/sh
# One purchase from the new isolated account. This is not bin/start and not bin/wake.
# It does not stay running. The token and phrase come from the environment.
# It does not signal 127.0.0.1:8787, 8792, or 8793.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$ROOT"
exec env \
  -u W0_SEED -u W1_SEED -u W2_SEED -u W3_SEED -u W4_SEED -u W5_SEED -u W6_SEED -u W7_SEED \
  -u W1_REGULAR_SEED -u W2_REGULAR_SEED -u W3_REGULAR_SEED -u W4_REGULAR_SEED -u W5_REGULAR_SEED -u W6_REGULAR_SEED \
  -u AETHER_SECRETS -u FOUNDRY_AGENT_SIGN -u MISSION_XRPL_SEED \
  -u FOUNDRY_MISSION_EXECUTE \
  node src/missions/execute-once.js
