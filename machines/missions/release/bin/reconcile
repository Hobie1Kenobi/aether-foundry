#!/bin/sh
# Report one signed claim, or release it only with the audit phrase.
# The mission selector is FOUNDRY_MISSION_RECONCILE_MISSION. Without it the
# process exits PLAN and does not release.
# Report only: set the selector and do not set FOUNDRY_MISSION_RECONCILE_PHRASE.
# Release: also set FOUNDRY_MISSION_RECONCILE_PHRASE=AUDIT-RELEASE-PASSED-WINDOW
# and FOUNDRY_MISSION_RECONCILE_TOKEN (at least 32 characters, from the
# environment, not this file). Release still requires a validated creation
# proof and complete_ledgers covering that creation ledger through
# LastLedgerSequence. txnNotFound alone is not a release.
# This does not sign, retry, or print the environment.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$ROOT"
exec env \
  -u W0_SEED -u W1_SEED -u W2_SEED -u W3_SEED -u W4_SEED -u W5_SEED -u W6_SEED -u W7_SEED \
  -u W1_REGULAR_SEED -u W2_REGULAR_SEED -u W3_REGULAR_SEED -u W4_REGULAR_SEED -u W5_REGULAR_SEED -u W6_REGULAR_SEED \
  -u AETHER_SECRETS -u FOUNDRY_AGENT_SIGN -u MISSION_XRPL_SEED \
  -u FOUNDRY_MISSION_EXECUTE \
  node src/missions/reconcile-claim.js
