#!/bin/sh
# Authenticated arming. Default start stays off until this succeeds.
# Does not print the seed. Does not raise the 1 XRP / 5 XRP caps.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$ROOT"
HOME_DIR=${FOUNDRY_MISSION_HOME:-/workspace/foundry-ops/missions-runtime}
install -d "$HOME_DIR" "$HOME_DIR/ledger"
if [ -z "${FOUNDRY_MISSION_TOKEN:-}" ] || [ "${FOUNDRY_MISSION_CONFIRM:-}" != "ACTIVATE-XRPL1-MISSION-SPEND" ]; then
  echo "ARM" >&2
  exit 1
fi
env \
  -u W0_SEED -u W1_SEED -u W2_SEED -u W3_SEED -u W4_SEED -u W5_SEED -u W6_SEED -u W7_SEED \
  -u W1_REGULAR_SEED -u W2_REGULAR_SEED -u W3_REGULAR_SEED -u W4_REGULAR_SEED -u W5_REGULAR_SEED -u W6_REGULAR_SEED \
  -u AETHER_SECRETS -u FOUNDRY_AGENT_SIGN -u MISSION_XRPL_SEED \
  FOUNDRY_MISSION_HOME="$HOME_DIR" \
  FOUNDRY_MISSION_LEDGER="${FOUNDRY_MISSION_LEDGER:-$HOME_DIR/ledger}" \
  FOUNDRY_MISSION_TOKEN="$FOUNDRY_MISSION_TOKEN" \
  FOUNDRY_MISSION_CONFIRM="$FOUNDRY_MISSION_CONFIRM" \
  node src/missions/arm.js
