[Unit]
Description=Aether Foundry loopback agent signer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/aether-foundry
EnvironmentFile=/workspace/aether-foundry-secrets/.env
ExecStart=/usr/bin/npm run signer
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
