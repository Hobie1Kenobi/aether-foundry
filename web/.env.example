# Public XRPL Testnet only. NO seeds. NO private keys.
# Desk ledger reads use HTTPS JSON-RPC. Defaults work with no env set on Vercel.
NEXT_PUBLIC_XRPL_HTTP=https://s.altnet.rippletest.net:51234
# Optional. Used only when NEXT_PUBLIC_XRPL_HTTP is unset (port 51233 maps to 51234).
NEXT_PUBLIC_XRPL_WS=wss://s.altnet.rippletest.net:51233
NEXT_PUBLIC_NETWORK_LABEL=XRPL Testnet

# Server-only. Do not prefix with NEXT_PUBLIC_. Vercel does not load this file.
# Project → Settings → Environment Variables → Production (and Preview if you want it there).
# Unset keeps /api/status facilitator.mode = self-verify and remoteVerify = false.
# The only accepted value is the T54 XRPL Testnet facilitator. Mainnet hosts are refused.
# The desk may POST /verify. It does not call settle. No secret belongs in this variable.
# XRPL_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
# XRPL_NETWORK=xrpl:1
