# XRPL Testnet / Devnet / Xahau — NEVER put mainnet seeds here.
# Copy to .env locally. Do not commit .env.

XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234

# Seeds: local only. Public addresses go in corp/wallets.md
TREASURY_SEED=
MARKET_SEED=
ATELIER_SEED=
CHANNELS_SEED=
ESCROW_SEED=
RD_SEED=
# W6 grants flywheel prefers W6_REGULAR_SEED, then W6_SEED, then GRANTS_SEED.
GRANTS_SEED=
W6_SEED=
XAHAU_SEED=
# Xahau Testnet W7 split. Placeholders only. Never commit real seeds.
W7_SEED=
W7_MARKET_SEED=
W7_ATELIER_SEED=
W7_RD_SEED=
W7_GRANTS_SEED=
W7_SINK_SEED=
W7_PAYER_SEED=

# Week-2 XRPL Testnet board. Placeholders only. npm run gov:live generates values into the secrets file.
# Never commit real seeds.
SIGNER_DIRECTOR_SEED=
SIGNER_TREASURER_SEED=
SIGNER_ATELIER_SEED=
SIGNER_MARKET_SEED=
W1_REGULAR_SEED=
W2_REGULAR_SEED=
W3_REGULAR_SEED=
W4_REGULAR_SEED=
W5_REGULAR_SEED=
W6_REGULAR_SEED=
# F4 domain shop. Placeholders. The issuer is W5_REGULAR_SEED. Never W0_SEED.
CDS_AGENT_SEED=
CDS_STRANGER_SEED=
CDS_MINT_SEED=

# XRPL Devnet (network id 2) F8/F9/F10. Placeholders only. Never commit real seeds.
# Public addresses stay _blank_ in corp/wallets.md until the Foundry box funds them.
# Do not point these at Testnet W0-W6, BUYER, STRANGER, AMM, or FOREIGN.
D0_ADDRESS=
D1_ADDRESS=
D2_ADDRESS=
D3_ADDRESS=
D_CONF_SENDER_ADDRESS=
D0_SEED=
D1_SEED=
D2_SEED=
D3_SEED=
D_CONF_SENDER_SEED=
# ElGamal seeds are not the signing seeds. Losing one makes that confidential balance unreadable.
D0_ELGAMAL_SEED=
D3_ELGAMAL_SEED=
D_CONF_SENDER_ELGAMAL_SEED=
